PORT=3000
# development enables the mock SMS provider (OTP in logs) and the sandbox payment gateway.
# docker-compose defaults to production: use `NODE_ENV=development docker compose up -d api` locally.
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=petzi
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin login: run `npm run migration:run` to create the seed admin user
# (username: petziappadmin) against the configured database above.

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_REDIRECT_URL=http://localhost:5173/auth/callback

# OTP
OTP_EXPIRES_IN_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS (mock in development)
SMS_PROVIDER=mock

# App
# Public URL of this API as the browser reaches it (payment callbacks, sandbox page).
# With docker compose the API is published on host port $PORT, e.g. http://localhost:4000.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
# Frontend base URL for shareable vet/clinic links (/services/vet/:id, /services/clinic/:id).
# Optional. If empty, falls back to the origin of FRONTEND_REDIRECT_URL, then the first CORS_ORIGINS entry.
# Also used for the payment result redirect (/services/payment).
PUBLIC_SITE_URL=
