PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=petzi
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin login: run `npm run migration:run` to create the seed admin user
# (username: petziappadmin) against the configured database above.

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_REDIRECT_URL=http://localhost:5173/auth/callback

# OTP
OTP_EXPIRES_IN_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS (mock in development)
SMS_PROVIDER=mock

# App
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
